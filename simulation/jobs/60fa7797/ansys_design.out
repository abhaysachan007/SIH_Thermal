   431  ! ============================================================  
   432  ! TRANSIENT THERMAL FEA — 24-Hour Ladakh Climate Simulation   
   433  ! (Called after shelter_design.apdl has built & meshed the geometry)
   434  ! ============================================================  
   435      
   436  /PREP7  
   437      
   438  ! ============================================================  
   439  ! THERMAL BOUNDARY CONDITIONS   
   440  ! Exterior surface nodes selection  
   441  ! ============================================================  
   442      
   443  ! Select exterior face nodes
   444  NSEL,S,LOC,Y,-0.31,-0.29          ! Foundation bottom face  
   445  NSEL,A,LOC,X,-0.01, 0.01          ! West outer face 
   446  NSEL,A,LOC,X,(SLEN+2*WTHK-0.01),(SLEN+2*WTHK+0.01)  ! East outer face   
   447      
   448  ! Roof top exterior nodes   
   449  *IF,ROOFT,EQ,1,THEN 
   450    *SET,ROOF_TOP,SHGT+1.6+0.35   
   451  *ELSE   
   452    *SET,ROOF_TOP,SHGT+0.35   
   453  *ENDIF  
   454  NSEL,A,LOC,Y,(ROOF_TOP-0.02),(ROOF_TOP+0.05)
   455      
   456  ! South wall exterior nodes 
   457  NSEL,A,LOC,Z,-0.01,0.01 
   458      
   459  ! North wall exterior nodes 
   460  NSEL,A,LOC,Z,(SWID+2*WTHK-0.01),(SWID+2*WTHK+0.01)  
   461      
   462  ! Save as component for convection BC   
   463  CM,EXT_NODES,NODE   
   464      
   465  ! Apply time-varying convection on all exterior surfaces using passed tables
   466  SF,EXT_NODES,CONV,%HEXT_TB%,%TAMB_TB%   
   467      
   468  ! Solar flux on South wall exterior 
   469  NSEL,S,LOC,Z,-0.01,0.01 
   470  SF,ALL,HFLUX,%QSOLS_TB% 
   471      
   472  ! Solar flux on Roof
   473  NSEL,S,LOC,Y,(ROOF_TOP-0.02),(ROOF_TOP+0.05)
   474  SF,ALL,HFLUX,%QSOLR_TB% 
   475      
   476  ! Ground / Foundation Bottom: Constant deep-ground temp (4°C Ladakh)   
   477  NSEL,S,LOC,Y,-0.32,-0.28
   478  D,ALL,TEMP,GNDTEMP  
   479      
   480  ! Interior Air Convection   
   481  NSEL,ALL
   482  NSEL,S,LOC,Z,(WTHK*0.4),(WTHK*0.6)  
   483  NSEL,A,LOC,Z,(SWID+WTHK*1.4),(SWID+WTHK*1.6)
   484  NSEL,A,LOC,X,(WTHK*0.4),(WTHK*0.6)  
   485  NSEL,A,LOC,X,(SLEN+WTHK*1.4),(SLEN+WTHK*1.6)
   486  SF,ALL,CONV,4.0,T_INSIDE_INIT   
   487      
   488  ALLSEL,ALL  
   489      
   490  ! Initial Temperature Condition 
   491  IC,ALL,TEMP,T0  
   492      
   493  ! ============================================================  
   494  ! TRANSIENT THERMAL SOLVER SETTINGS 
   495  ! ============================================================  
   496  FINISH  
   497  /SOLU   
   498      
   499  ANTYPE,TRANS          ! Transient thermal analysis  
   500  TRNOPT,FULL           ! Full transient  
   501  TIMINT,ON             ! Time integration ON 
   502  KBC,0                 ! Ramped loading between time steps   
   503      
   504  DELTIM,3600,600,3600  ! Time step: 1 hour (3600 s)  
   505  OUTRES,ALL,ALL        ! Save all results every sub-step 
   506  NSUBST,1,6,1
   507      
   508  ! Solve 24 time steps (24 hours)
   509  *DO,IHOUR,1,NHRS
   510    TIME,IHOUR*3600   
   511    SOLVE 
   512  *ENDDO  
   513      
   514  FINISH  
   515      
   516  ! ============================================================  
   517  ! POST-PROCESSING: Extract Temperature Results  
   518  ! ============================================================  
   519  /POST1  
   520      
   521  ! Read last time step   
   522  SET,LAST
   523      
   524  ! Get temperature extremes  
   525  *GET,T_MAX_ALL,NODE,0,TEMP,MAX  
   526  *GET,T_MIN_ALL,NODE,0,TEMP,MIN  
   527  *GET,T_AVG_ALL,NODE,0,TEMP,MEAN 
   528      
   529  ! Interior core nodes   
   530  NSEL,S,LOC,X,(WTHK+0.3),(WTHK+SLEN-0.3) 
   531  NSEL,R,LOC,Z,(WTHK+0.3),(WTHK+SWID-0.3) 
   532  NSEL,R,LOC,Y,0.2,(SHGT-0.2) 
   533  *GET,T_INT_MAX,NODE,0,TEMP,MAX  
   534  *GET,T_INT_MIN,NODE,0,TEMP,MIN  
   535  *GET,T_INT_AVG,NODE,0,TEMP,MEAN 
   536  ALLSEL,ALL  
   537      
   538  ! South wall inner surface temperature  
   539  NSEL,S,LOC,Z,(WTHK*0.85),(WTHK*1.15)
   540  NSEL,R,LOC,Y,0.5,(SHGT*0.8) 
   541  *GET,T_SWALL_IN,NODE,0,TEMP,MEAN
   542  ALLSEL,ALL  
   543      
   544  ! ============================================================  
   545  ! Write thermal results CSV 
   546  ! ============================================================  
   547  *CFOPEN,thermal_out,csv,,APPEND 
   548  *CFWRITE,PARAM,VALUE
   549  *CFWRITE,peak_inside_temp_C,%T_INT_MAX% 
   550  *CFWRITE,min_inside_temp_C,%T_INT_MIN%  
   551  *CFWRITE,avg_inside_temp_C,%T_INT_AVG%  
   552  *CFWRITE,max_any_temp_C,%T_MAX_ALL% 
   553  *CFWRITE,min_any_temp_C,%T_MIN_ALL% 
   554  *CFWRITE,south_wall_inner_temp_C,%T_SWALL_IN%   
   555      
   556  ! Extract 24 hourly interior temperature steps from FEA database
   557  *DO,IH,1,NHRS   
   558    SET,IH
   559    NSEL,S,LOC,X,(WTHK+0.3),(WTHK+SLEN-0.3)   
   560    NSEL,R,LOC,Z,(WTHK+0.3),(WTHK+SWID-0.3)   
   561    NSEL,R,LOC,Y,0.2,(SHGT-0.2)   
   562    *GET,T_HR_VAL,NODE,0,TEMP,MEAN
   563    ALLSEL,ALL
   564    *CFWRITE,hour_%IH%,%T_HR_VAL% 
   565  *ENDDO  
   566      
   567  *CFCLOS 
   568      
   569  FINISH  
   570  /EOF

