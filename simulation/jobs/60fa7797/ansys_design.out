    19  /TITLE, Ladakh Passive Shelter - Parametric 3D Model (Frontend Mirror)  
    20      
    21  ! ============================================================  
    22  ! PARAMETERS injected by run_design.apdl:   
    23  !   SLEN   - Length (m)         SWID  - Width (m)   
    24  !   SHGT   - Wall Height (m)    WTHK  - Wall Thickness (m)  
    25  !   NWIN   - Windows on south wall   NDOOR - Doors (0,1,2)  
    26  !   SHAPE  - 0=Rectangular  1=Dome/Igloo
    27  !   ROOFT  - 0=Flat roof    1=Gable pitched roof
    28  !   KWALL/RHOWALL/CPWALL  - Wall material properties
    29  !   KROOF/RHOROOF/CPROOF  - Roof material properties
    30  !   KFLOOR/RHOFLOOR/CPFLOOR - Floor material properties 
    31  ! ============================================================  
    32      
    33  ! Defaults (overridden by run_design.apdl header)   
    34  *SET,SLEN,6.0   $ *SET,SWID,4.0   $ *SET,SHGT,3.0  $ *SET,WTHK,0.45 
    35  *SET,NWIN,3     $ *SET,NDOOR,1    $ *SET,SHAPE,0   $ *SET,ROOFT,1   
    36  *SET,KWALL,0.72 $ *SET,RHOWALL,1800 $ *SET,CPWALL,840   
    37  *SET,KROOF,0.15 $ *SET,RHOROOF,650  $ *SET,CPROOF,1200  
    38  *SET,KFLOOR,1.80$ *SET,RHOFLOOR,2400$ *SET,CPFLOOR,900  
    39      
    40  /PREP7  
    41  ET,1,SOLID70
    42      
    43  ! --- Materials --- 
    44  MP,KXX,1,KWALL  $ MP,DENS,1,RHOWALL  $ MP,C,1,CPWALL
    45  MP,KXX,2,KROOF  $ MP,DENS,2,RHOROOF  $ MP,C,2,CPROOF
    46  MP,KXX,3,1.80   $ MP,DENS,3,2400     $ MP,C,3,900   
    47  MP,KXX,4,1.00   $ MP,DENS,4,2500     $ MP,C,4,750   
    48  MP,KXX,5,0.15   $ MP,DENS,5,650      $ MP,C,5,1200  
    49  MP,KXX,6,KFLOOR $ MP,DENS,6,RHOFLOOR $ MP,C,6,CPFLOOR   
    50      
    51  ! ============================================================  
    52  *IF,SHAPE,EQ,1,THEN 
    53  ! ===========================================================   
    54  ! DOME / IGLOO (mirrors frontend iglooMat hemisphere)   
    55  ! ===========================================================   
    56    *SET,DOME_R,(SLEN+SWID)*0.25+0.3  
    57    *SET,DOME_H,SHGT  
    58    TYPE,1 $ MAT,3
    59    CYLIND,0,(DOME_R+0.25),-0.12,0,0,360  
    60    TYPE,1 $ MAT,6
    61    CYLIND,0,(DOME_R-0.1),0,0.12,0,360
    62    TYPE,1 $ MAT,1
    63    SPHERE,(DOME_R-WTHK),DOME_R,0,90,0,360
    64    TYPE,1 $ MAT,1
    65    *SET,TUNL,1.4 
    66    *SET,TUNW,0.9 
    67    CYLIND,0,TUNW/2,DOME_R,(DOME_R+TUNL),0,180
    68      
    69  *ELSE   
    70  ! ===========================================================   
    71  ! RECTANGULAR HOUSE (mirrors frontend buildWall engine) 
    72  ! ===========================================================   
    73      
    74    ! 1. Foundation Plinth (Mat 3)
    75    TYPE,1 $ MAT,3
    76    BLOCK,0,(SLEN+2*WTHK),0,(SWID+2*WTHK),-0.3,0  
    77      
    78    ! 2. Floor Slab (Mat 6)   
    79    TYPE,1 $ MAT,6
    80    BLOCK,WTHK,(SLEN+WTHK),WTHK,(SWID+WTHK),0,0.15
    81      
    82    ! 3. North Wall - Solid (Mat 1)   
    83    TYPE,1 $ MAT,1
    84    BLOCK,WTHK,(SLEN+WTHK),(SWID+WTHK),(SWID+2*WTHK),0,SHGT   
    85      
    86    ! 4. West Wall - Solid (Mat 1)
    87    TYPE,1 $ MAT,1
    88    BLOCK,0,WTHK,0,(SWID+2*WTHK),0,SHGT   
    89      
    90    ! 5. East Wall - Solid (Mat 1)
    91    TYPE,1 $ MAT,1
    92    BLOCK,(SLEN+WTHK),(SLEN+2*WTHK),0,(SWID+2*WTHK),0,SHGT
    93      
    94    ! 6. South Wall - Dynamic openings (mirrors frontend layout engine)   
    95    *SET,MARGIN,0.4   
    96    *SET,TITEMS,NDOOR+NWIN
    97    *SET,DOOR_W,0.9   
    98    *SET,DOOR_H,2.1   
    99    *SET,WIN_W,1.2
   100    *SET,WIN_H,1.2
   101    *SET,WIN_SILL,0.85
   102    *SET,WIN_TOP,WIN_SILL+WIN_H   
   103      
   104    ! Cursor starts at left margin
   105    *SET,CUR,WTHK+MARGIN  
   106      
   107    ! Left corner pillar (before door)
   108    TYPE,1 $ MAT,1
   109    BLOCK,WTHK,CUR,0,WTHK,0,SHGT  
   110      
   111    ! DOOR 1  
   112    *IF,NDOOR,GE,1,THEN   
   113      *SET,DX1,CUR
   114      *SET,DX2,CUR+DOOR_W 
   115      TYPE,1 $ MAT,5  
   116      BLOCK,DX1,DX2,(WTHK*0.25),(WTHK*0.75),0,DOOR_H  
   117      *SET,CUR,DX2+0.35   
   118    *ENDIF
   119      
   120    ! DOOR 2  
   121    *IF,NDOOR,GE,2,THEN   
   122      *SET,DX3,CUR
   123      *SET,DX4,CUR+DOOR_W 
   124      TYPE,1 $ MAT,1  
   125      BLOCK,DX2,DX3,0,WTHK,0,SHGT 
   126      TYPE,1 $ MAT,5  
   127      BLOCK,DX3,DX4,(WTHK*0.25),(WTHK*0.75),0,DOOR_H  
   128      *SET,CUR,DX4+0.35   
   129    *ENDIF
   130      
   131    ! Compute window gap  
   132    *SET,END_X,WTHK+SLEN-MARGIN   
   133    *SET,WIN_GAP,0.3  
   134    *IF,NWIN,GT,0,THEN
   135      *SET,WIN_GAP,(END_X-CUR-NWIN*WIN_W)/NWIN
   136      *IF,WIN_GAP,LT,0.2,THEN 
   137        *SET,WIN_GAP,0.2  
   138      *ENDIF  
   139    *ENDIF
   140      
   141    ! WINDOW 1
   142    *SET,PREV_WIN_END,CUR 
   143    *IF,NWIN,GE,1,THEN
   144      *SET,WX1,CUR
   145      *SET,WX2,CUR+WIN_W  
   146      TYPE,1 $ MAT,1  
   147      BLOCK,PREV_WIN_END,WX1,0,WTHK,0,SHGT
   148      BLOCK,WX1,WX2,0,WTHK,0,WIN_SILL 
   149      TYPE,1 $ MAT,4  
   150      BLOCK,WX1,WX2,(WTHK*0.35),(WTHK*0.65),WIN_SILL,WIN_TOP  
   151      *SET,PREV_WIN_END,WX2   
   152      *SET,CUR,WX2+WIN_GAP
   153    *ENDIF
   154      
   155    ! WINDOW 2
   156    *IF,NWIN,GE,2,THEN
   157      *SET,WX3,CUR
   158      *SET,WX4,CUR+WIN_W  
   159      TYPE,1 $ MAT,1  
   160      BLOCK,PREV_WIN_END,WX3,0,WTHK,0,SHGT
   161      BLOCK,WX3,WX4,0,WTHK,0,WIN_SILL 
   162      TYPE,1 $ MAT,4  
   163      BLOCK,WX3,WX4,(WTHK*0.35),(WTHK*0.65),WIN_SILL,WIN_TOP  
   164      *SET,PREV_WIN_END,WX4   
   165      *SET,CUR,WX4+WIN_GAP
   166    *ENDIF
   167      
   168    ! WINDOW 3
   169    *IF,NWIN,GE,3,THEN
   170      *SET,WX5,CUR
   171      *SET,WX6,CUR+WIN_W  
   172      TYPE,1 $ MAT,1  
   173      BLOCK,PREV_WIN_END,WX5,0,WTHK,0,SHGT
   174      BLOCK,WX5,WX6,0,WTHK,0,WIN_SILL 
   175      TYPE,1 $ MAT,4  
   176      BLOCK,WX5,WX6,(WTHK*0.35),(WTHK*0.65),WIN_SILL,WIN_TOP  
   177      *SET,PREV_WIN_END,WX6   
   178      *SET,CUR,WX6
   179    *ENDIF
   180      
   181    ! Right corner pillar 
   182    TYPE,1 $ MAT,1
   183    BLOCK,PREV_WIN_END,(SLEN+WTHK),0,WTHK,0,SHGT  
   184      
   185    ! Lintel beam above all openings  
   186    *SET,MAX_OH,DOOR_H
   187    *IF,WIN_TOP,GT,DOOR_H,THEN
   188      *SET,MAX_OH,WIN_TOP 
   189    *ENDIF
   190    *IF,SHGT-MAX_OH,GT,0.05,THEN  
   191      TYPE,1 $ MAT,1  
   192      BLOCK,WTHK,(SLEN+WTHK),0,WTHK,MAX_OH,SHGT   
   193    *ENDIF
   194      
   195    ! 7. ROOF 
   196    *IF,ROOFT,EQ,1,THEN   
   197      ! Gable Pitched Roof (mirrors frontend roofType='pitched')  
   198      *SET,PH,1.6 
   199      TYPE,1 $ MAT,2  
   200      ! South slope   
   201      BLOCK,-0.4,(SLEN+2*WTHK+0.4),-0.4,(SWID/2+WTHK),SHGT,(SHGT+PH*0.55+0.15)
   202      ! North slope   
   203      BLOCK,-0.4,(SLEN+2*WTHK+0.4),(SWID/2+WTHK),(SWID+2*WTHK+0.4),SHGT,(SHGT+PH*0.55+0.15)   
   204      ! Ridge cap 
   205      BLOCK,-0.4,(SLEN+2*WTHK+0.4),(SWID/2+WTHK-0.12),(SWID/2+WTHK+0.12),(SHGT+PH*0.55),(SHGT+PH+0.15)
   206      ! Gable end walls   
   207      TYPE,1 $ MAT,1  
   208      BLOCK,(SLEN+WTHK),(SLEN+2*WTHK+0.4),-0.4,(SWID+2*WTHK+0.4),SHGT,(SHGT+PH*0.55)  
   209      BLOCK,-0.4,WTHK,-0.4,(SWID+2*WTHK+0.4),SHGT,(SHGT+PH*0.55)  
   210      ! Chimney stack (Mat 2) 
   211      TYPE,1 $ MAT,2  
   212      BLOCK,(WTHK+1.0),(WTHK+1.5),(WTHK+SWID*0.35),(WTHK+SWID*0.35+0.5),SHGT,(SHGT+PH+0.9)
   213    *ELSE 
   214      ! Flat Roof with Overhang (mirrors roofType='flat') 
   215      TYPE,1 $ MAT,2  
   216      BLOCK,-0.3,(SLEN+2*WTHK+0.3),-0.3,(SWID+2*WTHK+0.3),SHGT,(SHGT+0.35)
   217    *ENDIF
   218      
   219  *ENDIF  
   220      
