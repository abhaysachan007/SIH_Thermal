FINISH
/CLEAR,NOSTART
/TITLE, Ladakh Passive Shelter - 3D House Front Facade
*SET,SLEN,6.0
*SET,SWID,4.0
*SET,SHGT,3.0
*SET,WTHK,0.40

/PREP7
ET,1,SOLID70

! Materials
MP,KXX,1,0.72 $ MP,DENS,1,1800 $ MP,C,1,840
MP,KXX,2,0.15 $ MP,DENS,2,650  $ MP,C,2,1200
MP,KXX,3,1.80 $ MP,DENS,3,2400 $ MP,C,3,900
MP,KXX,4,1.00 $ MP,DENS,4,2500 $ MP,C,4,750
MP,KXX,5,0.15 $ MP,DENS,5,650  $ MP,C,5,1200

! 1. Foundation Base
TYPE,1 $ MAT,3
BLOCK, 0, (SLEN+2*WTHK),  -0.2, (SWID+2*WTHK+0.2),  -0.3, 0

! 2. Back & Side Walls
TYPE,1 $ MAT,1
BLOCK, WTHK, (SLEN+WTHK),  (SWID+WTHK), (SWID+2*WTHK),  0, SHGT
BLOCK, 0,    WTHK,          0, (SWID+2*WTHK),  0, SHGT
BLOCK, (SLEN+WTHK), (SLEN+2*WTHK),  0, (SWID+2*WTHK),  0, SHGT

! 3. Front Wall Openings (South Facade at Y=0 to Y=WTHK)
*SET,DX1, WTHK + 0.5
*SET,DX2, WTHK + 1.4
*SET,DH,  2.1
*SET,W1X1, WTHK + 2.0
*SET,W1X2, WTHK + 3.4
*SET,W2X1, WTHK + 4.0
*SET,W2X2, WTHK + 5.4
*SET,WSILL, 0.9
*SET,WTOP,  2.1

TYPE,1 $ MAT,1
BLOCK, WTHK, DX1,  0, WTHK,  0, SHGT
BLOCK, DX2, W1X1,  0, WTHK,  0, SHGT
BLOCK, W1X1, W1X2,  0, WTHK,  0, WSILL
BLOCK, W1X2, W2X1,  0, WTHK,  0, SHGT
BLOCK, W2X1, W2X2,  0, WTHK,  0, WSILL
BLOCK, W2X2, (SLEN+WTHK),  0, WTHK,  0, SHGT
BLOCK, WTHK, (SLEN+WTHK),  0, WTHK,  WTOP, SHGT

! Windows (Cyan Glass) & Door (Wood)
TYPE,1 $ MAT,4
BLOCK, W1X1, W1X2,  (WTHK*0.2), (WTHK*0.8),  WSILL, WTOP
BLOCK, W2X1, W2X2,  (WTHK*0.2), (WTHK*0.8),  WSILL, WTOP

TYPE,1 $ MAT,5
BLOCK, DX1, DX2,  (WTHK*0.1), (WTHK*0.9),  0, DH

! Roof with Eaves Overhang
TYPE,1 $ MAT,2
BLOCK, -0.3, (SLEN+2*WTHK+0.3),  -0.3, (SWID+2*WTHK+0.3),  SHGT, (SHGT+0.3)

ESIZE,0.45
VMESH,ALL

ALLSEL,ALL
! Set Z-axis UP and Camera facing the South (Front) Facade at Y < 0
/VUP,1,Z
/VIEW,1, 1.2, -1.8, 1.0
/ANG,1, 0
/AUTO,1

/PNUM,MAT,1
/NUM,1
/COLOR,MAT,ORAN,1
/COLOR,MAT,RED,2
/COLOR,MAT,DGRA,3
/COLOR,MAT,CYAN,4
/COLOR,MAT,MAGE,5
/FACET,FINE
/SHRINK,0.03
VPLOT
/REPLOT
